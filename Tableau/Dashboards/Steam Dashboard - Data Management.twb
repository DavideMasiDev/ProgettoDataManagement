        <named-connections>
          <named-connection caption='localhost' name='postgres.1w610le1fk1hft1gl4h5z1r34vdf'>
            <connection authentication='username-password' class='postgres' dbname='steamdb' odbc-connect-string-extras='UseDeclareFetch=0' odbc-native-protocol='' one-time-sql='' port='5432' server='localhost' username='postgres'>
