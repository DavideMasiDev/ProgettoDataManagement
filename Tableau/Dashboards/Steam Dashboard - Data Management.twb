      <table>
        <view>
          <datasources>
            <datasource caption='Dettaglio popolarita generi' name='federated.0bu8v7l0v46vwh15q9evo1x5p916' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Generi Selezionati' datatype='string' name='[Parametro 5]' param-domain-type='any' role='measure' type='nominal' value='&quot;Action RPG, City Builder&quot;'>
              <calculation class='tableau' formula='&quot;Action RPG, City Builder&quot;' />
            </column>
            <column caption='Filtra top 20 con almeno 1000 recensioni' datatype='boolean' name='[Parametro 6]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bu8v7l0v46vwh15q9evo1x5p916'>
            <column caption='Top 20 Games Toggle Filter' datatype='boolean' name='[Calculation_1521090804552949760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Parameters].[Parametro 6] = FALSE THEN &#13;&#10;    TRUE&#13;&#10;ELSEIF [Parameters].[Parametro 6] = TRUE AND [Top 20 Games Set] THEN &#13;&#10;    TRUE&#13;&#10;ELSE &#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='Perc positive reviews' datatype='real' name='[Calculation_369858149490843654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_positive_reviews]/[total_reviews]' />
            </column>
            <column caption='Filtro generi selezionati' datatype='boolean' name='[Calculation_369858149495205895]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(genres, &apos;,&apos; + SPLIT([Parameters].[Parametro 5], &quot;, &quot;, 1) + &apos;,&apos;) &#13;&#10;AND &#13;&#10;CONTAINS(genres, &apos;,&apos; + SPLIT([Parameters].[Parametro 5], &quot;, &quot;, 2) + &apos;,&apos;)' />
            </column>
            <column caption='is_indie' datatype='boolean' name='[Calculation_369858149496381448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='FIND([genres], &quot;Indie&quot;) != 0' />
            </column>
            <column datatype='real' name='[estimated_revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[game_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[genres]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1521090804552949760]' derivation='None' name='[none:Calculation_1521090804552949760:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_369858149495205895]' derivation='None' name='[none:Calculation_369858149495205895:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_369858149496381448]' derivation='None' name='[none:Calculation_369858149496381448:nk]' pivot='key' type='nominal' />
            <column-instance column='[game_name]' derivation='None' name='[none:game_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_369858149490843654]' derivation='Sum' name='[sum:Calculation_369858149490843654:qk]' pivot='key' type='quantitative' />
