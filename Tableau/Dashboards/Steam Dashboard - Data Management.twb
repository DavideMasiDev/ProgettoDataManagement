        <relation connection='postgres.19ix5tn162a160132hxe3160m2zb' name='Query SQL personalizzata' type='text'>select sg.game_name, df.regular_price, df.price as deal_price, df.deal, d.full_date, c.currency_code, s.shop_name, gsf.estimated_revenue&#13;&#10;from &quot;DATAMART&quot;.deal_fact df &#13;&#10;join &quot;DATAMART&quot;.currency c on (df.currency_pk = c.currency_pk)&#13;&#10;join &quot;DATAMART&quot;.shop s on (s.shop_pk = df.shop_pk)&#13;&#10;join &quot;DATAMART&quot;.steam_game sg on (sg.steam_game_pk = df.steam_game_pk)&#13;&#10;join &quot;DATAMART&quot;.&quot;date&quot; d on (d.date_pk = df.deal_date_pk)&#13;&#10;join &quot;DATAMART&quot;.game_statistics_fact gsf on (gsf.steam_game_pk = df.steam_game_pk)</relation>
