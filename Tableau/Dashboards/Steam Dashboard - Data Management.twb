          <zone h='98466' id='7' param='horz' type='layout-flow' w='99166' x='417' y='767'>
            <zone h='98466' id='5' type='layout-basic' w='99166' x='417' y='767'>
              <zone h='49056' id='3' name='Popolarità coppie di generi negli Indie' w='99166' x='417' y='7957'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
