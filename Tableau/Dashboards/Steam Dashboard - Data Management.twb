    <datasource caption='Popolarità generi' inline='true' name='federated.03n4kdn0hs2gq212hxhg41p9pzdz' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='localhost' name='postgres.1w610le1fk1hft1gl4h5z1r34vdf'>
            <connection authentication='username-password' class='postgres' dbname='steamdb' odbc-connect-string-extras='UseDeclareFetch=0' odbc-native-protocol='' one-time-sql='' port='5432' server='localhost' username='postgres'>
              <connection-customization class='postgres' enabled='false' version='18.1'>
                <vendor name='postgres' />
                <driver name='postgres' />
                <customizations>
                  <customization name='odbc-connect-string-extras' value='UseDeclareFetch=0' />
