      <column caption='Filtro generi selezionati' datatype='boolean' name='[Calculation_369858149495205895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(genres, &apos;,&apos; + SPLIT([Parameters].[Parametro 5], &quot;, &quot;, 1) + &apos;,&apos;) &#13;&#10;AND &#13;&#10;CONTAINS(genres, &apos;,&apos; + SPLIT([Parameters].[Parametro 5], &quot;, &quot;, 2) + &apos;,&apos;)' />
