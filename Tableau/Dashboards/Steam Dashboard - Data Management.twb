            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Genere da Evidenziare' datatype='string' name='[Parametro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Open World&quot;'>
              <calculation class='tableau' formula='&quot;Open World&quot;' />
            </column>
            <column caption='Attiva Filtro' datatype='boolean' datatype-customized='true' name='[Parametro 4]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03n4kdn0hs2gq212hxhg41p9pzdz'>
            <column caption='Giochi in almeno uno dei due generi' datatype='integer' name='[Calculation_1820861653673476096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([count_giochi_1] + [count_giochi_2]) - [count_giochi_coppie]' />
            </column>
            <column caption='Coppie Giochi' datatype='string' name='[Calculation_1820861653673750529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[genre_name_1] + &apos;, &apos; + [genre_name_2]' />
            </column>
            <column caption='Logica per evidenziare genere' datatype='boolean' name='[Calculation_369858149469896707]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parametro 3] = [genre_name_1] OR [Parameters].[Parametro 3] = [genre_name_2]' />
            </column>
            <column caption='Logica: attiva filtro' datatype='boolean' name='[Calculation_369858149476163589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Parameters].[Parametro 4] OR ([Parameters].[Parametro 3] = [genre_name_1] OR [Parameters].[Parametro 3] = [genre_name_2])' />
            </column>
            <column datatype='integer' name='[count_giochi_1]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_giochi_2]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_giochi_coppie]' role='measure' type='quantitative' />
            <column datatype='string' name='[genre_name_1]' role='dimension' type='nominal' />
            <column datatype='string' name='[genre_name_2]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1820861653673750529]' derivation='None' name='[none:Calculation_1820861653673750529:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_369858149469896707]' derivation='None' name='[none:Calculation_369858149469896707:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_369858149476163589]' derivation='None' name='[none:Calculation_369858149476163589:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1820861653673476096]' derivation='Sum' name='[sum:Calculation_1820861653673476096:qk]' pivot='key' type='quantitative' />
            <column-instance column='[count_giochi_coppie]' derivation='Sum' name='[sum:count_giochi_coppie:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
