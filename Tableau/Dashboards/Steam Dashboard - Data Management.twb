              <groupfilter from='&quot;Action RPG, Auto Battler&quot;' function='range' level='[none:Calculation_1820861653673750529:nk]' to='&quot;Horror, Survival&quot;' />
              <groupfilter from='&quot;Horror, Tactical RPG&quot;' function='range' level='[none:Calculation_1820861653673750529:nk]' to='&quot;Tactical RPG, Visual Novel&quot;' />
            </groupfilter>
