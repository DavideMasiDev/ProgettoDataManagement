            <column-instance column='[Calculation_1728537846770274309]' derivation='User' name='[usr:Calculation_1728537846770274309:qk]' pivot='key' type='quantitative' />
            <column-instance column='[release_date]' derivation='Year' name='[yr:release_date:ok]' pivot='key' type='ordinal' />
