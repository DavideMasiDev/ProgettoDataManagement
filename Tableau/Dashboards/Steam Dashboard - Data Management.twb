      <column caption='deal FIXED game, date, shop' datatype='real' name='[Calculation_1025694847275954176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [game_name], [full_date], [shop_name] : max(deal) }' />
      </column>
      <column caption='Fascia di successo' datatype='string' name='[Calculation_1053279396741586944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1053279396743778305] &gt;= 30000000 THEN &quot;1. Top Tier (&gt;1M)&quot;&#13;&#10;ELSEIF [Calculation_1053279396743778305] &gt;= 100000 THEN &quot;2. Mid Tier (100k-1M)&quot;&#13;&#10;ELSE &quot;3. Low Tier (&lt;100k)&quot;&#13;&#10;END' />
      </column>
      <column caption='Estimated Revenue Fixed Game' datatype='real' name='[Calculation_1053279396743778305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [game_name]: MAX([estimated_revenue]) }' />
      </column>
      <column caption='Regular price FIXED' datatype='real' name='[Calculation_1053279396751335426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [game_name], [full_date], [shop_name] : max([regular_price]) }' />
      </column>
      <column caption='Deal / 100' datatype='real' name='[Calculation_516506615513620480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[deal] / 100' />
      </column>
      <column caption='Fascia di successo - Regular price' datatype='string' name='[Calculation_803048144926593026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1053279396751335426] &gt;= 70 THEN &quot;1. Top Tier (&gt;70€)&quot;&#13;&#10;ELSEIF [Calculation_1053279396751335426] &gt;= 30 THEN &quot;2. Mid Tier (30-70€)&quot;&#13;&#10;ELSE &quot;3. Low Tier (&lt;30€)&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
