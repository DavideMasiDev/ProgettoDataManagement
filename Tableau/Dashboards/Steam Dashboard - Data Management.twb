        <relation connection='postgres.0s80b630xvj75s18fhah11itfnyy' name='Query SQL personalizzata' type='text'>select&#13;&#10;    gsf.steam_game_pk,&#13;&#10;    gsf.game_statistics_fact_pk, &#13;&#10;    gsf.estimated_revenue,&#13;&#10;    gsf.estimated_wishlists,&#13;&#10;    gsf.total_negative_reviews,&#13;&#10;    gsf.total_positive_reviews,&#13;&#10;    gsf.average_forever,&#13;&#10;    sg.&quot;type&quot;,&#13;&#10;    sg.fullgame,&#13;&#10;    sg.game_name,&#13;&#10;    sg.steam_appid,&#13;&#10;    g.genre_name,&#13;&#10;    g.genre_pk,&#13;&#10;    g.classification,&#13;&#10;    d.full_date as release_date,&#13;&#10;    de.developer_name&#13;&#10;from &quot;DATAMART&quot;.game_statistics_fact gsf&#13;&#10;join &quot;DATAMART&quot;.steam_game sg on sg.steam_game_pk = gsf.steam_game_pk&#13;&#10;join &quot;DATAMART&quot;.bridge_genre bg on bg.steam_game_pk = sg.steam_game_pk&#13;&#10;join &quot;DATAMART&quot;.genre g on g.genre_pk = bg.genre_pk&#13;&#10;join &quot;DATAMART&quot;.date d on sg.release_date_pk = d.date_pk&#13;&#10;join &quot;DATAMART&quot;.bridge_developer bd on bd.steam_game_pk = sg.steam_game_pk&#13;&#10;join &quot;DATAMART&quot;.developer de on de.developer_pk = bd.developer_pk</relation>
