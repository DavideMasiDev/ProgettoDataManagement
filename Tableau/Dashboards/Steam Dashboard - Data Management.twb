    <worksheet name='Top 50 Giochi per Positive Reviews'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='11'>Top 50 Giochi per &lt;</run>
            <run bold='true' fontalignment='1' fontsize='11'>[Parameters].[Parametro 1]</run>
            <run bold='true' fontalignment='1' fontsize='11'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Steam statistics 2' name='federated.1cbwpom0onu3bs1ax8n8l0xu25yh' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Misure da visualizzare' datatype='string' name='[Parametro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Positive reviews&quot;'>
              <calculation class='tableau' formula='&quot;Positive reviews&quot;' />
            </column>
            <column caption='Misure per cui ordinare' datatype='string' datatype-customized='true' name='[Parametro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Numero di recensioni&quot;'>
              <calculation class='tableau' formula='&quot;Numero di recensioni&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cbwpom0onu3bs1ax8n8l0xu25yh'>
            <column caption='Valori misure da visualizzare' datatype='real' name='[Calculation_1728537846396370944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 1] = &apos;Positive reviews&apos;&#13;&#10;THEN MAX([total_positive_reviews])&#13;&#10;ELSEIF [Parameters].[Parametro 1] = &apos;Negative reviews&apos;&#13;&#10;THEN MAX([total_negative_reviews])&#13;&#10;END' />
            </column>
            <column caption='Misure per cui ordinare' datatype='real' name='[Calculation_1728537846770274309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 2] = &apos;Percentuale&apos;&#13;&#10;THEN MAX([Calculation_975029331288649730])&#13;&#10;ELSEIF [Parameters].[Parametro 2] = &apos;Numero di recensioni&apos;&#13;&#10;THEN [Calculation_1728537846396370944]&#13;&#10;END' />
            </column>
            <column caption='Filtro Generi Selezionati' datatype='boolean' name='[Calculation_514254807471476736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED : COUNTD(IF [Generi Selezionati] THEN [genre_name] END)}&#13;&#10;=&#13;&#10;{ FIXED [game_name] : COUNTD(IF [Generi Selezionati] THEN [genre_name] END) }' />
            </column>
            <column caption='Valori percentuali reviews da visualizzare' datatype='real' name='[Calculation_975029331288649730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 1] = &apos;Positive reviews&apos;&#13;&#10;THEN [Calculation_975029331290718211]&#13;&#10;ELSEIF [Parameters].[Parametro 1] = &apos;Negative reviews&apos;&#13;&#10;THEN [Calculation_975029331291566084]&#13;&#10;END' />
            </column>
            <column caption='Perc positive reviews' datatype='real' name='[Calculation_975029331290718211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_positive_reviews]/[Calculation_975029331296235525]' />
            </column>
            <column caption='Perc negative reviews' datatype='real' name='[Calculation_975029331291566084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_negative_reviews]/[Calculation_975029331296235525]' />
            </column>
            <column caption='Total reviews' datatype='real' name='[Calculation_975029331296235525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_positive_reviews] + [total_negative_reviews]' />
            </column>
            <column datatype='string' name='[developer_name]' role='dimension' type='nominal' />
            <column caption='Game name' datatype='string' name='[game_name]' role='dimension' type='nominal' />
            <column caption='Genre name' datatype='string' name='[genre_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_975029331288649730]' derivation='Max' name='[max:Calculation_975029331288649730:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_514254807471476736]' derivation='None' name='[none:Calculation_514254807471476736:nk]' pivot='key' type='nominal' />
            <column-instance column='[game_name]' derivation='None' name='[none:game_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[type]' derivation='None' name='[none:type:nk]' pivot='key' type='nominal' />
            <column caption='Data di rilascio' datatype='datetime' name='[release_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[total_negative_reviews]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_positive_reviews]' role='measure' type='quantitative' />
            <column datatype='string' name='[type]' role='dimension' type='nominal' />
